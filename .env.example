# ══════════════════════════════════════════════════════════
#  Personal Blog Platform — Environment Variables (EXAMPLE)
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file.
# ══════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=3000

# ─── Session / Auth ───────────────────────────────────────
# REQUIRED in production. Long random string (>= 16 chars, 32+ recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Session cookie lifetime in milliseconds (default: 86400000 = 24 hours)
SESSION_MAX_AGE_MS=86400000
# Cookie name (default: sid)
SESSION_COOKIE_NAME=sid

# Force the `Secure` cookie flag on/off. Leave unset to auto
# (Secure is forced automatically when NODE_ENV=production).
# COOKIE_SECURE=true

# bcrypt cost factor — higher is slower & safer (default: 10)
BCRYPT_ROUNDS=10

# Role assigned to new sign-ups: user | author | admin (default: author)
DEFAULT_REGISTRATION_ROLE=author

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed front-end origins.
# Leave empty for same-origin only (recommended for this app).
# Example: https://myblog.example.com,https://www.example.com
ALLOWED_ORIGINS=

# ─── Rate limiting ────────────────────────────────────────
# Login: max 10 failed attempts / 15 min.
# Register: max 20 new accounts / hour.
# (Values are defined in middleware/rateLimiters.js.)

# ══════════════════════════════════════════════════════════
#  DATABASE
#  Every connection setting is read from the DB_* variables
#  below, so the same code runs against local MySQL and
#  TiDB Cloud without modification.
# ══════════════════════════════════════════════════════════

# ─── Local MySQL (development) ────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=personal_blog

# ─── Connection pool ──────────────────────────────────────
DB_CONNECTION_LIMIT=10

# ─── TLS ──────────────────────────────────────────────────
# true | false  (default: false)
# TiDB Cloud REQUIRES TLS, so set this to true for TiDB.
DB_SSL=false
# true | false  (default: true) — keep true in production
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA certificate (single-line or \n-escaped)
# DB_SSL_CA=

# ══════════════════════════════════════════════════════════
#  TiDB CLOUD (production) — replace the values above with:
#
#    DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
#    DB_PORT=4000
#    DB_USER=<username>.root
#    DB_PASSWORD=<generated password>
#    DB_NAME=test
#    DB_SSL=true
#    DB_SSL_REJECT_UNAUTHORIZED=true
#
#  Copy host / port / user / password / database from the
#  TiDB Cloud console → your cluster → Connect. TiDB Cloud
#  always requires an encrypted connection, and its certificate
#  is publicly trusted, so TLS 1.2+ validation works with no
#  extra CA file.
# ══════════════════════════════════════════════════════════
